generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id                 String    @id @default(cuid())
  sessionId          String?   @map("session_id")
  name               String
  purpose            String
  tier               String
  devinSessionId     String?   @map("devin_session_id")
  devinUrl           String?   @map("devin_url")
  runtimeProvider    String?   @map("runtime_provider")
  runtimeAgentId     String?   @map("runtime_agent_id")
  runtimeSessionId   String?   @map("runtime_session_id")
  runtimeUrl         String?   @map("runtime_url")
  deployState        String    @default("pending") @map("deploy_state")
  deployErrorCode    String?   @map("deploy_error_code")
  deployErrorMessage String?   @map("deploy_error_message")
  lastHeartbeatAt    DateTime? @map("last_heartbeat_at")
  status             String    @default("pending")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  customer_email     String?
  customer_name      String?
  deployed_at        DateTime?
  description        String?
  payment_session_id String?
  slug               String    @unique
  features           String[]
  userId             String?   @map("user_id")
  user               User?     @relation(fields: [userId], references: [id])
  subscriptionStatus String    @default("trial") @map("subscription_status")
  subscriptionType   String    @default("monthly") @map("subscription_type")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  lastPaymentId      String?   @map("last_payment_id")

  // Bot activation fields
  activationStatus String    @default("pending") @map("activation_status") // pending, activating, awaiting_verification, active, failed
  botUsername      String?   @map("bot_username")
  telegramLink     String?   @map("telegram_link")
  authCode         String?   @map("auth_code")
  verifiedAt       DateTime? @map("verified_at")
  telegramUserId   String?   @map("telegram_user_id")
  cortexId         String    @default("matt-consumer") @map("cortex_id")
  deployJobs       DeployJob[]

  @@index([status])
  @@index([devinSessionId])
  @@index([payment_session_id])
  @@index([slug])
  @@index([userId])
  @@index([activationStatus])
  @@index([deployState])
  @@index([runtimeProvider])
  @@index([runtimeAgentId])
  @@map("agents")
}

model Payment {
  id          String    @id @default(cuid())
  sessionId   String    @map("session_id")
  tier        String
  currency    String
  amount      Float
  address     String
  status      String    @default("pending")
  txHash      String?   @map("tx_hash")
  confirmedAt DateTime? @map("confirmed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  userId      String?   @map("user_id")

  @@index([sessionId])
  @@index([address])
  @@index([status])
  @@index([userId])
  @@map("payments")
}

model DeployJob {
  id             String    @id @default(cuid())
  agentId        String    @map("agent_id")
  type           String    @default("deploy")
  status         String    @default("queued")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5) @map("max_attempts")
  idempotencyKey String    @unique @map("idempotency_key")
  providerHint   String?   @map("provider_hint")
  payload        Json?
  errorCode      String?   @map("error_code")
  errorMessage   String?   @map("error_message")
  lastAttemptAt  DateTime? @map("last_attempt_at")
  nextRunAt      DateTime  @default(now()) @map("next_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  agent          Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status])
  @@index([status, nextRunAt])
  @@map("deploy_jobs")
}


model User {
  id               String    @id @default(cuid())
  privyId          String    @unique @map("privy_id")
  email            String?
  walletAddress    String?   @map("wallet_address")
  name             String?
  avatar           String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")

  // Relations
  agents Agent[]

  @@index([email])
  @@index([walletAddress])
  @@map("users")
}

model InferenceLog {
  id                  String   @id @default(cuid())
  agentId             String   @map("agent_id")
  cortexId            String   @map("cortex_id")

  // Classification
  classifiedTier      String   @map("classified_tier")
  actualTier          String   @map("actual_tier")
  classificationScore Int      @map("classification_score")
  budgetAdjusted      Boolean  @default(false) @map("budget_adjusted")

  // Model
  provider            String
  model               String
  wasFailover         Boolean  @default(false) @map("was_failover")

  // Tokens
  inputTokens         Int      @map("input_tokens")
  outputTokens        Int      @map("output_tokens")
  cachedInputTokens   Int      @default(0) @map("cached_input_tokens")

  // Cost
  costUsd             Float    @map("cost_usd")
  dailyBudgetPct      Float    @map("daily_budget_pct")

  // Performance
  latencyMs           Int      @map("latency_ms")
  ttftMs              Int?     @map("ttft_ms")

  // Quality signals
  contextCompressed   Boolean  @default(false) @map("context_compressed")
  errorOccurred       Boolean  @default(false) @map("error_occurred")
  errorCode           String?  @map("error_code")

  createdAt           DateTime @default(now()) @map("created_at")

  @@index([agentId, createdAt])
  @@index([cortexId, createdAt])
  @@index([createdAt])
  @@map("inference_logs")
}
