generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Agent {
  id                 String    @id @default(cuid())
  sessionId          String?   @map("session_id")
  name               String
  purpose            String
  tier               String
  devinSessionId     String?   @map("devin_session_id")
  devinUrl           String?   @map("devin_url")
  status             String    @default("pending")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  customer_email     String?
  customer_name      String?
  deployed_at        DateTime?
  description        String?
  payment_session_id String?
  slug               String    @unique
  features           String[]
  userId             String?   @map("user_id")
  user               User?     @relation(fields: [userId], references: [id])
  subscriptionStatus String    @default("trial") @map("subscription_status")
  subscriptionType   String    @default("monthly") @map("subscription_type")
  currentPeriodStart DateTime? @map("current_period_start")
  currentPeriodEnd   DateTime? @map("current_period_end")
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  lastPaymentId      String?   @map("last_payment_id")

  // Bot activation fields
  activationStatus String    @default("pending") @map("activation_status") // pending, activating, awaiting_verification, active, failed
  botUsername      String?   @map("bot_username")
  telegramLink     String?   @map("telegram_link")
  authCode         String?   @map("auth_code")
  verifiedAt       DateTime? @map("verified_at")
  telegramUserId   String?   @map("telegram_user_id")

  @@index([status])
  @@index([devinSessionId])
  @@index([payment_session_id])
  @@index([slug])
  @@index([userId])
  @@index([activationStatus])
  @@map("agents")
}

model Payment {
  id          String    @id @default(cuid())
  sessionId   String    @map("session_id")
  tier        String
  currency    String
  amount      Float
  address     String
  status      String    @default("pending")
  txHash      String?   @map("tx_hash")
  confirmedAt DateTime? @map("confirmed_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  userId      String?   @map("user_id")

  @@index([sessionId])
  @@index([address])
  @@index([status])
  @@index([userId])
  @@map("payments")
}

model WalletPool {
  id                  String    @id @default(cuid())
  address             String    @unique
  encryptedPrivateKey String    @map("encrypted_private_key")
  status              String    @default("available")
  assignedToSession   String?   @map("assigned_to_session")
  assignedAt          DateTime? @map("assigned_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  hyperBalance        String    @default("0") @map("hyper_balance")
  pmApproved          Boolean   @default(false) @map("pm_approved")

  @@index([status])
  @@index([assignedToSession])
  @@map("wallet_pool")
}

model User {
  id               String    @id @default(cuid())
  privyId          String    @unique @map("privy_id")
  email            String?
  walletAddress    String?   @map("wallet_address")
  name             String?
  avatar           String?
  stripeCustomerId String?   @map("stripe_customer_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  lastLoginAt      DateTime? @map("last_login_at")
  isBanned         Boolean   @default(false) @map("is_banned")
  banReason        String?   @map("ban_reason")

  // Relations
  agents     Agent[]
  adminNotes AdminNote[]
  fleets     Fleet[]

  @@index([email])
  @@index([walletAddress])
  @@index([stripeCustomerId])
  @@index([isBanned])
  @@map("users")
}

// Invoice records for payments
model Invoice {
  id            String    @id @default(cuid())
  paymentId     String    @unique @map("payment_id")
  invoiceNumber String    @unique @map("invoice_number")
  status        String    @default("draft") // draft, sent, paid
  pdfUrl        String?   @map("pdf_url")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("invoices")
}

// Activity log for audit trail
model ActivityLog {
  id         String   @id @default(cuid())
  action     String // user_created, payment_confirmed, agent_deployed, etc.
  entityType String   @map("entity_type") // user, agent, payment
  entityId   String   @map("entity_id")
  actorId    String?  @map("actor_id") // admin who performed action
  metadata   String? // JSON string
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

// Admin notes for users
model AdminNote {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  content   String
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("admin_notes")
}

// System settings (key-value store for CMS)
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("system_settings")
}

// Website content for CMS
model WebsiteContent {
  id        String   @id @default(cuid())
  section   String // hero, features, pricing, footer, etc.
  key       String // title, description, cta_text, etc.
  value     String // The actual content
  type      String   @default("text") // text, markdown, html
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@unique([section, key])
  @@index([section])
  @@map("website_content")
}

// ============================================
// FLEET MODE - Scalable Agent Deployment
// ============================================

// Fleet - A group of agents deployed together
model Fleet {
  id     String @id @default(cuid())
  userId String @map("user_id")

  // Identification
  name        String
  description String?
  slug        String  @unique

  // Status: draft, provisioning, deploying, running, scaling, error, paused, terminated
  status        String  @default("draft")
  statusMessage String? @map("status_message")

  // Configuration (JSON)
  config String // FleetConfig serialized

  // Progress tracking (JSON)
  progress String // FleetProgress serialized

  // Runtime info (JSON)
  runtimeInfo String? @map("runtime_info")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  agents FleetAgent[]

  @@index([userId])
  @@index([status])
  @@index([slug])
  @@map("fleets")
}

// FleetAgent - Individual agent instance within a fleet
model FleetAgent {
  id      String @id @default(cuid())
  fleetId String @map("fleet_id")
  userId  String @map("user_id")

  // Agent identity
  name           String
  instanceNumber Int    @map("instance_number")

  // Status: pending, provisioning, starting, running, error, stopped, updating
  status        String  @default("pending")
  statusMessage String? @map("status_message")

  // Configuration (JSON)
  config String // AgentTemplate serialized

  // Runtime info (JSON)
  runtime String? // Runtime details (endpoint, sessionId, etc.)

  // Health check (JSON)
  health String? // Health check results

  // Timestamps
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  startedAt    DateTime? @map("started_at")
  lastActiveAt DateTime? @map("last_active_at")

  // Relations
  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@index([fleetId])
  @@index([userId])
  @@index([status])
  @@index([instanceNumber])
  @@map("fleet_agents")
}

// Fleet Events - Audit log for fleet operations
model FleetEvent {
  id      String  @id @default(cuid())
  fleetId String  @map("fleet_id")
  agentId String? @map("agent_id")

  // Event type
  type String // fleet.created, agent.deployed, etc.

  // Event data (JSON)
  data String?

  // Timestamp
  createdAt DateTime @default(now()) @map("created_at")

  @@index([fleetId])
  @@index([agentId])
  @@index([type])
  @@index([createdAt])
  @@map("fleet_events")
}

// InfrastructureServer - Cloud VPS instances running OpenClaw
model InfrastructureServer {
  id      String @id @default(cuid())
  fleetId String @map("fleet_id")

  // Provider info
  provider           String // contabo, aws, gcp, etc.
  providerInstanceId String @map("provider_instance_id")

  // Server details
  name   String
  status String // provisioning, installing, ready, active, full, error, terminated

  // Network
  publicIp  String? @map("public_ip")
  privateIp String? @map("private_ip")
  hostname  String

  // Configuration (JSON)
  specs          String // ServerSpecs
  region         String
  openclawConfig String @map("openclaw_config")

  // Capacity tracking (JSON)
  capacity String // { maxAgents, currentAgents, availableSlots }

  // Costs (JSON)
  cost String // { hourlyRate, currency }

  // Timestamps
  createdAt    DateTime  @default(now()) @map("created_at")
  readyAt      DateTime? @map("ready_at")
  lastActiveAt DateTime? @map("last_active_at")
  terminatedAt DateTime? @map("terminated_at")

  @@index([fleetId])
  @@index([provider])
  @@index([status])
  @@index([region])
  @@map("infrastructure_servers")
}
